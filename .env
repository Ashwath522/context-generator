# MODE controls which LLM client is used.
#   test        -> uses test/mockLlmClient.js, zero API calls, zero cost
#   production  -> makes real REST calls to the Gemini API below
MODE=test

# ---- Gemini REST API config (only used when MODE=production) ----
# Get a key from https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_MODEL=gemini-2.0-flash
